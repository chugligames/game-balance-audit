{
  "title": "Slide Mini",
  "segment": "level",
  "profiles": ["novice", "typical", "expert"],
  "focus_profile": "typical",
  "metrics": {
    "optimal": { "label": "Shortest solution (moves)", "expect": "rise" },
    "explored": { "label": "Positions a full search visits", "expect": "rise" },
    "solved": { "label": "Solve rate", "expect": "fall", "min_growth": 0.2 },
    "moves": { "label": "Moves used when solved" }
  },
  "targets": [
    { "metric": "solved", "profile": "expert", "min": 1, "label": "Every level can be solved" },
    { "metric": "optimal", "profile": "expert", "segments": [8, 12], "min": 6, "label": "No pushover from level 8 on" },
    { "metric": "solved", "profile": "typical", "min": 0.2, "label": "A typical player can get through each level", "severity": "medium" }
  ],
  "skill": { "metric": "solved", "strong": "typical", "weak": "novice", "min_gap": 0.1 }
}
